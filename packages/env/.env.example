# ============================================================
# 🔗 Shared
# ============================================================

# ✅ required - Public URL of the API server.
VITE_SERVER_URL="http://localhost:5000/server"

# ✅ required - Public URL of the web app.
VITE_WEB_URL="http://localhost:3000"

# ⚙️ optional - Node environment.
NODE_ENV="development"

# ✅ required - PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/saasweave"
# Set false when connecting through a transaction-mode pooler (PgBouncer/Supabase pooler)
DATABASE_PREPARED_STATEMENTS="true"
DATABASE_MAX_CONNECTIONS="10"

# ✅ required - Secret key for Better Auth. Generate with: vp run auth:secret
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# ============================================================
# 🌍 Web
# ============================================================

# ⚙️ optional - Base URL for imgproxy. Leave empty to disable.
VITE_IMGPROXY_URL=""

# ⚙️ optional - imgproxy signature path segment. Defaults to "_" for unsigned imgproxy URLs.
# Use "insecure" or a precomputed signature string if your imgproxy setup requires it.
VITE_IMGPROXY_SIGNATURE="_"

# ⚙️ optional - Origin imgproxy fetches from. Leave empty to use VITE_WEB_URL.
# In Docker Compose set to http://web:3000 so imgproxy can reach the web container.
VITE_IMGPROXY_SOURCE_WEB_URL=""

# ============================================================
# 🖥️ Server
# ============================================================

# ⚙️ optional - Expose the OpenAPI /docs endpoint.
ENABLE_OPEN_API_DOCS="false"

# ⚙️ optional - Require verified email before sign-in (env-defaulted; secure by default).

# ⚙️ optional - Trust X-Forwarded-For / X-Real-IP for auth rate limits (enable behind a trusted reverse proxy).
TRUST_PROXY_HEADERS="false"

# ⚙️ optional - Attach CSP, HSTS, and related headers on API responses (env-defaulted; secure by default).
# SECURITY_HEADERS_ENABLED="true"
# SECURITY_CSP_REPORT_ONLY="false"
# SECURITY_CSP_REPORT_URI="https://collector.example/csp"

# ============================================================
# 🔨 Build
# ============================================================

# ⚙️ optional - Git commit SHA injected at build time.
SOURCE_COMMIT=""

# ⚙️ optional - Comma-separated emails granted the platform-admin role on sign-up.
# Leave empty to fall back to "first registered user becomes admin".
PLATFORM_ADMIN_EMAILS=""

# ⚙️ optional - Redis-backed shared cache and queues. Leave empty to disable Redis in local dev.
REDIS_URL="redis://localhost:6379/0"
CACHE_PREFIX="saasweave"
CACHE_DEFAULT_TTL_SECONDS=300
QUEUE_PREFIX="saasweave"
WORKER_CONCURRENCY=5

# ⚙️ optional - Stripe billing. Leave STRIPE_SECRET_KEY empty for sample-billing mode.
# Set a Stripe **test** secret key to activate live subscriptions + customer portal.
STRIPE_SECRET_KEY=""
# From `stripe listen` or the Stripe dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=""
# JSON map of plan -> Stripe price IDs by interval, e.g. {"growth":{"monthly":"price_...","annual":"price_..."}}
STRIPE_PRICES="{}"
# ⚙️ optional - JSON map of usage metric -> Stripe billing meter event_name, e.g. {"ai_tokens":"ai_tokens"}
STRIPE_METERS="{}"

# ⚙️ optional - Transactional email. "console" logs instead of sending.
MAIL_PROVIDER="console"
MAIL_FROM="SaaSWeave <hello@example.com>"
# For MAIL_PROVIDER=resend
RESEND_API_KEY=""
# For MAIL_PROVIDER=smtp, e.g. smtp://user:pass@smtp.host.com:587
SMTP_URL=""

# Optional OAuth providers (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ⚙️ optional - MinIO / S3-compatible object storage (Docker Compose provides defaults).
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET="uploads"
MINIO_ACCESS_KEY_ID="minioadmin"
MINIO_SECRET_ACCESS_KEY="minioadmin"
MINIO_PUBLIC_BASE_URL="http://localhost:9000/uploads"
MEDIA_UPLOAD_DIR=".uploads"
MEDIA_PUBLIC_BASE_URL="http://localhost:5000/server/media"

# ⚙️ optional - BullMQ cron for invitation expiry (default: daily at 03:00 UTC).
WORKER_SCHEDULE_INVITATION_CRON="0 3 * * *"
WORKER_SCHEDULE_MRR_SNAPSHOT_CRON="0 2 * * *"
WORKER_SCHEDULE_STORAGE_CLEANUP_CRON="30 4 * * *"
WORKER_SCHEDULE_DATA_RETENTION_CRON="0 5 * * *"
WORKER_HEALTH_PORT=9100
METRICS_ENABLED=false
# Required when metrics are enabled; send as Authorization: Bearer <token>.
METRICS_BEARER_TOKEN=
OTEL_TRACE_SAMPLE_RATE=0.1
RETENTION_PURGE_DRY_RUN=false
RETENTION_LEGAL_HOLD_ORG_IDS=
BACKUP_RESTORE_ALLOW_REMOTE=false
