{
  "name": "@saasweave/web",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "dev": "pnpm dotenvx run -f ../../packages/env/.env -- vp dev",
    "preview": "pnpm dotenvx run -f ../../packages/env/.env -- vp preview",
    "start": "pnpm dotenvx run -f ../../packages/env/.env -- node .output/server/index.mjs",
    "test:e2e": "cross-env VITEST_E2E=1 pnpm dotenvx run -f ../../packages/env/.env -- vp test",
    "test:e2e:pw": "playwright test",
    "test:e2e:pw:ci": "playwright test __e2e__/playwright/auth.spec.ts --grep-invert \"deferred browser flows\"",
    "test:unit": "vp test",
    "ui": "vpx shadcn@latest"
  },
