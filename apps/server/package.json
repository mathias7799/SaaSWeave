{
  "name": "@saasweave/server",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#@/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production IS_BUILD=true vp pack",
    "compile": "cross-env NODE_ENV=production IS_BUILD=true BUILD_EXE=true pnpm dotenvx run -f ../../packages/env/.env -- vp pack",
    "dev": "pnpm dotenvx run -f ../../packages/env/.env -- node --import tsx --watch src/index.ts",
    "start": "pnpm dotenvx run -f ../../packages/env/.env -- node .output/index.mjs",
    "test:unit": "vp test"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@saasweave/api": "workspace:*",
    "@saasweave/app": "workspace:*",
    "@saasweave/auth": "workspace:*",
    "@saasweave/cache": "workspace:*",
    "@saasweave/core": "workspace:*",
    "@saasweave/db": "workspace:*",
    "@saasweave/env": "workspace:*",
    "@saasweave/logger": "workspace:*",
    "@saasweave/observability": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@saasweave/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
