# ============================================================
# Local Docker Compose — copy to .env.docker
#   cp .env.docker.example .env.docker
#   pnpm dotenvx run -f .env.docker -- docker compose up --build
# ============================================================

# ============================================================
# URLs (must match how you access services from the browser)
# ============================================================

VITE_SERVER_URL=http://localhost:5000/server
VITE_WEB_URL=http://localhost:3000

# ============================================================
# Core secrets
# ============================================================

# Generate: vp run auth:secret
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-generated-locally

NODE_ENV=production
SOURCE_COMMIT=

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=saasweave
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/saasweave

# ============================================================
# Redis (required in production for shared cache, rate limits, workers)
# ============================================================

REDIS_URL=redis://redis:6379/0
# Single-instance production escape hatch only — cache/rate limits stay per-process.
# ALLOW_SINGLE_INSTANCE_FALLBACK=true
REDIS_PORT=6379
CACHE_PREFIX=saasweave
CACHE_DEFAULT_TTL_SECONDS=300
QUEUE_PREFIX=saasweave
WORKER_CONCURRENCY=5

# ============================================================
# Host ports
# ============================================================

WEB_PORT=3000
SERVER_PORT=5000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
IMGPROXY_PORT=8080

# ============================================================
# Web — image optimization
# ============================================================

VITE_IMGPROXY_URL=http://localhost:8080
VITE_IMGPROXY_SIGNATURE=insecure
# Internal URL imgproxy uses to fetch web static assets (Docker service hostname).
VITE_IMGPROXY_SOURCE_WEB_URL=http://web:3000

# ============================================================
# Server — API docs & platform policy
# ============================================================

ENABLE_OPEN_API_DOCS=true
PLATFORM_ADMIN_EMAILS=

# Require verified email before sign-in (defaults true when NODE_ENV=production).
REQUIRE_EMAIL_VERIFICATION=false

# Trust X-Forwarded-For for auth rate limits — enable only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Baseline API security headers (defaults true when NODE_ENV=production).
SECURITY_HEADERS_ENABLED=true
# Emit Content-Security-Policy-Report-Only instead of enforcing CSP.
SECURITY_CSP_REPORT_ONLY=false
# Optional CSP violation collector (also accepts POST /server/csp-report).
# SECURITY_CSP_REPORT_URI=https://collector.example/csp

# ============================================================
# Stripe billing (leave STRIPE_SECRET_KEY empty for sample billing)
# ============================================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES={}
STRIPE_METERS={}

# ============================================================
# Email (console = log only; resend or smtp to send for real)
# ============================================================

MAIL_PROVIDER=console
MAIL_FROM=SaaSWeave <hello@example.com>
RESEND_API_KEY=
SMTP_URL=

# ============================================================
# OAuth (leave empty for email/password only)
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================
# Media storage — MinIO (enabled by default in Docker Compose)
# ============================================================

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=uploads
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_PUBLIC_BASE_URL=http://localhost:9000/uploads
MEDIA_UPLOAD_DIR=.uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/server/media

# ============================================================
# Worker schedules (BullMQ cron, UTC)
# ============================================================

WORKER_SCHEDULE_INVITATION_CRON=0 3 * * *
WORKER_SCHEDULE_MRR_SNAPSHOT_CRON=0 2 * * *
WORKER_SCHEDULE_STORAGE_CLEANUP_CRON=30 4 * * *
WORKER_SCHEDULE_DATA_RETENTION_CRON=0 5 * * *
WORKER_HEALTH_PORT=9100
METRICS_ENABLED=false
# Required when metrics are enabled; minimum 32 characters.
METRICS_BEARER_TOKEN=
OTEL_TRACE_SAMPLE_RATE=0.1
RETENTION_PURGE_DRY_RUN=false
RETENTION_LEGAL_HOLD_ORG_IDS=

# Production operations: docs/PRODUCTION-OPERATIONS.md
# BACKUP_RESTORE_ALLOW_REMOTE=false

# ============================================================
# SSO / SAML local test IdP (optional — profile: sso-test)
# Start with: docker compose --profile sso-test up -d sso-idp
# Runbook: docs/SSO-TESTING.md
# ============================================================

SSO_IDP_PORT=8081
SSO_TEST_SP_ENTITY_ID=http://localhost:8081/simplesaml/saml2/idp/metadata.php
SSO_TEST_SP_ACS_URL=http://localhost:5000/server/auth/sso/saml2/sp/acs/local-saml
SSO_TEST_SP_SLO_URL=http://localhost:5000/server/auth/sso/saml2/sp/slo/local-saml
